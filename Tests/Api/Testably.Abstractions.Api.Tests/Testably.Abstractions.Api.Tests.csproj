<Project Sdk="Microsoft.NET.Sdk">
	
	<PropertyGroup>
		<TargetFrameworks>net10.0</TargetFrameworks>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="aweXpect.Snapshots.PublicApi"/>
		<PackageReference Remove="System.Net.Http" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\..\Source\Testably.Abstractions.AccessControl\Testably.Abstractions.AccessControl.csproj"/>
		<ProjectReference Include="..\..\..\Source\Testably.Abstractions.Compression\Testably.Abstractions.Compression.csproj"/>
		<ProjectReference Include="..\..\..\Source\Testably.Abstractions.MemoryMappedFiles\Testably.Abstractions.MemoryMappedFiles.csproj"/>
		<ProjectReference Include="..\..\..\Source\Testably.Abstractions.Testing\Testably.Abstractions.Testing.csproj"/>
		<ProjectReference Include="..\..\..\Source\Testably.Abstractions\Testably.Abstractions.csproj"/>
	</ItemGroup>

	<!--
	    The net8.0 and net9.0 builds of Testably.Abstractions.Testing reference newer versions of these assemblies than
	    their .NET version provides, which a library build does not copy next to it, so the public API resolves them
	    from the output of the tests.
	-->
	<ItemGroup>
		<PackageDownload Include="System.Linq.AsyncEnumerable" Version="[10.0.6]"/>
		<PackageDownload Include="System.Threading.Channels" Version="[10.0.12]"/>
		<None Include="$(NuGetPackageRoot)system.linq.asyncenumerable/10.0.6/lib/net8.0/System.Linq.AsyncEnumerable.dll" CopyToOutputDirectory="PreserveNewest" Visible="false"/>
		<None Include="$(NuGetPackageRoot)system.threading.channels/10.0.12/lib/net8.0/System.Threading.Channels.dll" CopyToOutputDirectory="PreserveNewest" Visible="false"/>
	</ItemGroup>

	<!--
	    The tests read the builds of all target frameworks of the referenced projects, but a project reference only
	    builds the one that matches the tests. Without the target framework, the same builds as in the solution are
	    requested, which MSBuild runs only once; DispatchToInnerBuilds builds them without packing.
	-->
	<Target Name="BuildAllTargetFrameworksOfReferencedProjects" AfterTargets="Build">
		<MSBuild Projects="@(ProjectReference)" Targets="DispatchToInnerBuilds" RemoveProperties="TargetFramework"/>
	</Target>

</Project>
